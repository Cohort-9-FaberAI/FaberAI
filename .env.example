# Optional overrides for docker compose. The default local setup needs no .env.
FABERAI_WEB_PORT=5173
FABERAI_API_PORT=8000
FABERAI_REDIS_PORT=6379

# local = persistent SQLite + files in a Docker volume; no account required.
# supabase = use your existing analysis_jobs table and cad-uploads bucket.
FABERAI_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=

# Optional: without a provider key, report Q&A uses deterministic responses.
ANTHROPIC_API_KEY=
# For an Anthropic-compatible provider, use these instead:
FABERAI_AI_API_KEY=
FABERAI_AI_BASE_URL=
FABERAI_AI_MODEL=
